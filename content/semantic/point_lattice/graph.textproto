schema_version: 4
id: "semantic-point_lattice"
canvas { width: 640 height: 360 }
output: 2
nodes { id: 1 type_key: "component.official.point_lattice" schema_version: 1 }
nodes { id: 2 type_key: "output.texture" schema_version: 1 }
edges { id: 1 from: 1 to: 2 input: "source" }
components {
    type_key: "component.official.point_lattice"
    schema_version: 1
    output: 3
    nodes {
      id: 1
      type_key: "point.grid"
      schema_version: 1
