      from: 6
      to: 2
      input: "rotation"
    }
    edges {
      id: 6
      from: 5
      to: 7
      input: "time"
    }
    edges {
      id: 7
      from: 7
      to: 2
      input: "scale"
    }
    parameters { key: "columns" node: 1 property: "columns" group: "component.motion" }
    parameters { key: "rows" node: 1 property: "rows" group: "component.motion" }
    parameters { key: "point_size" node: 1 property: "point_size" group: "component.palette" }
    parameters { key: "color_a" node: 1 property: "color_a" group: "component.palette" }
    parameters { key: "rotation_speed" node: 6 property: "speed" group: "component.motion" }
