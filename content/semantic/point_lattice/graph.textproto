      type_key: "point.render"
      schema_version: 1
    }
    nodes {
      id: 5
      type_key: "core.time"
      schema_version: 1
    }
    nodes {
      id: 6
      type_key: "time.local"
      schema_version: 1
      properties {
        key: "duration"
        value {
          scalar: 360
        }
      }
      properties {
        key: "speed"
        value {
          scalar: 12
        }
      }
      properties {
        key: "time_mode"
        value {
          scalar: 1
        }
      }
    }
    nodes {
      id: 7
      type_key: "scalar.expression"
      schema_version: 1
      properties {
        key: "expression"
        value {
          expression: "0.8 + sin(time * tau * 0.2) * 0.15"
        }
      }
    }
    edges {
      id: 1
      from: 1
      to: 2
      input: "points"
    }
    edges {
      id: 2
      from: 2
      to: 3
      input: "points"
    }
    edges {
      id: 4
      from: 5
      to: 6
      input: "time"
    }
    edges {
