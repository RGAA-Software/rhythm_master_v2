schema_version: 4
id: "semantic-flow_glass"
canvas { width: 640 height: 360 }
output: 4
nodes { id: 1 type_key: "texture.gradient" schema_version: 1
    properties { key: "color_a" value { color { r: 0 g: 0 b: 0 a: 1 } } }
    properties { key: "color_b" value { color { r: 1 g: 1 b: 1 a: 1 } } }
}
nodes { id: 2 type_key: "texture.contours" schema_version: 1
    properties { key: "contour_count" value { scalar: 14 } }
    properties { key: "line_width" value { scalar: 0.16 } }
    properties { key: "color_a" value { color { r: 0.95 g: 0.56 b: 0.12 a: 1 } } }
    properties { key: "color_b" value { color { r: 0.008 g: 0.04 b: 0.09 a: 1 } } }
}
nodes { id: 3 type_key: "component.official.flow_glass" schema_version: 1
}
nodes { id: 4 type_key: "output.texture" schema_version: 1
}
edges { id: 1 from: 1 to: 2 input: "source" }
edges { id: 2 from: 2 to: 3 input: "source" }
edges { id: 3 from: 3 to: 4 input: "source" }
components { type_key: "component.official.flow_glass" schema_version: 1 title: "Flow glass" output: 11
nodes { id: 1 type_key: "core.time" schema_version: 1
}
nodes { id: 2 type_key: "scalar.constant" schema_version: 1
    properties { key: "value" value { scalar: 0.12 } }
}
nodes { id: 3 type_key: "scalar.expression" schema_version: 1
    properties { key: "expression" value { expression: "time * a" } }
}
nodes { id: 4 type_key: "audio.band" schema_version: 1
    properties { key: "audio_band" value { scalar: 12 } }
}
nodes { id: 5 type_key: "audio.band" schema_version: 1
    properties { key: "audio_band" value { scalar: 48 } }
}
nodes { id: 6 type_key: "scalar.constant" schema_version: 1
    properties { key: "value" value { scalar: 1 } }
}
nodes { id: 7 type_key: "scalar.expression" schema_version: 1
    properties { key: "expression" value { expression: "(0.045 + a * 0.24 + b * 0.12) * c" } }
}
nodes { id: 8 type_key: "texture.noise" schema_version: 1
    properties { key: "noise_scale" value { scalar: 3.8 } }
    properties { key: "contrast" value { scalar: 2 } }
    properties { key: "seed" value { scalar: 471 } }
    properties { key: "color_a" value { color { r: 0.1 g: 0.7 b: 0 a: 1 } } }
    properties { key: "color_b" value { color { r: 0.9 g: 0.3 b: 0 a: 1 } } }
}
nodes { id: 9 type_key: "texture.displace" schema_version: 1
    properties { key: "displace_mode" value { scalar: 1 } }
    properties { key: "rotation" value { scalar: 70 } }
}
nodes { id: 10 type_key: "texture.blur" schema_version: 1
    properties { key: "blur_radius" value { scalar: 5 } }
}
nodes { id: 11 type_key: "texture.composite" schema_version: 1
    properties { key: "composite_mode" value { scalar: 1 } }
    properties { key: "amount" value { scalar: 0.18 } }
}
edges { id: 1 from: 1 to: 3 input: "time" }
edges { id: 2 from: 2 to: 3 input: "a" }
edges { id: 3 from: 4 to: 7 input: "a" }
edges { id: 4 from: 5 to: 7 input: "b" }
edges { id: 5 from: 6 to: 7 input: "c" }
edges { id: 6 from: 3 to: 8 input: "phase" }
edges { id: 7 from: 8 to: 9 input: "displace_map" }
edges { id: 8 from: 7 to: 9 input: "displace_strength" }
edges { id: 9 from: 9 to: 10 input: "source" }
edges { id: 10 from: 9 to: 11 input: "a" }
edges { id: 11 from: 10 to: 11 input: "b" }
inputs { key: "source" node: 9 input: "source" }
parameters { key: "flow" node: 2 property: "value" group: "component.pattern" }
parameters { key: "response" node: 6 property: "value" group: "component.pattern" }
parameters { key: "pattern_scale" node: 8 property: "noise_scale" group: "component.pattern" }
parameters { key: "direction" node: 9 property: "rotation" group: "component.pattern" }
parameters { key: "softness" node: 10 property: "blur_radius" group: "component.pattern" }
parameters { key: "glow" node: 11 property: "amount" group: "component.pattern" }
}
