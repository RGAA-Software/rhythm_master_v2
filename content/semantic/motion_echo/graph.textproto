edges { id: 4 from: 4 to: 7 input: "a" }
edges { id: 5 from: 5 to: 7 input: "b" }
edges { id: 6 from: 6 to: 7 input: "c" }
edges { id: 7 from: 7 to: 8 input: "rotation" }
edges { id: 8 from: 8 to: 9 input: "source" }
edges { id: 9 from: 9 to: 10 input: "source" }
inputs { key: "source" node: 8 input: "source" }
parameters { key: "pace" node: 2 property: "value" group: "component.pattern" minimum: -45 maximum: 45 }
parameters { key: "response" node: 6 property: "value" group: "component.pattern" minimum: 0 maximum: 2 }
parameters { key: "scale" node: 8 property: "scale" group: "component.pattern" }
parameters { key: "decay" node: 9 property: "trail_half_life" group: "component.pattern" }
parameters { key: "expansion" node: 9 property: "trail_zoom_rate" group: "component.pattern" }
parameters { key: "echo_turn" node: 9 property: "trail_rotation_rate" group: "component.pattern" }
