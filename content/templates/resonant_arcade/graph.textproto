    titles { key: 1 value: "Music response / 音乐响应" }
    titles { key: 2 value: "Arcade pace / 拱廊节奏" }
    titles { key: 3 value: "Exposure / 曝光" }
    snapshots { id: 1 title: "Arrival"
        values { key: 1 value: 0.6 }
        values { key: 2 value: 0.65 }
        values { key: 3 value: -0.35 }
    }
    snapshots { id: 2 title: "Procession"
        values { key: 1 value: 1.1 }
        values { key: 2 value: 1 }
        values { key: 3 value: -0.2 }
    }
    snapshots { id: 3 title: "Resonance"
        values { key: 1 value: 1.6 }
        values { key: 2 value: 1.35 }
        values { key: 3 value: -0.05 }
    }
    cues { id: 1 title: "Enter" seconds: 0 snapshot: 1 fade: 0 smooth: true }
    cues { id: 2 title: "Procession" seconds: 3 snapshot: 2 fade: 2 smooth: true }
    cues { id: 3 title: "Resonance" seconds: 8 snapshot: 3 fade: 2 smooth: true }
    cues { id: 4 title: "Return" seconds: 12 snapshot: 1 fade: 3 smooth: true }
}
