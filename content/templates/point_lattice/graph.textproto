schema_version: 2
id: "official-point_lattice"
canvas { width: 1280 height: 720 }
output: 4
nodes { id: 1 type_key: "point.grid" schema_version: 1 }
nodes { id: 2 type_key: "point.transform" schema_version: 1 }
nodes { id: 3 type_key: "point.render" schema_version: 1 }
nodes { id: 4 type_key: "output.texture" schema_version: 1 }
nodes { id: 5 type_key: "core.time" schema_version: 1 }
nodes { id: 6 type_key: "time.local" schema_version: 1
    properties { key: "speed" value { scalar: 12 } }
    properties { key: "duration" value { scalar: 360 } }
    properties { key: "time_mode" value { scalar: 1 } }
}
nodes { id: 7 type_key: "scalar.expression" schema_version: 1
    properties { key: "expression" value { expression: "0.8 + sin(time * tau * 0.2) * 0.15" } }
}
nodes { id: 8 type_key: "texture.gradient" schema_version: 1
    properties { key: "color_a" value { color { r: 0.008 g: 0.015 b: 0.04 a: 1 } } }
    properties { key: "color_b" value { color { r: 0.03 g: 0.01 b: 0.08 a: 1 } } }
}
nodes { id: 9 type_key: "texture.composite" schema_version: 1 }
edges { id: 1 from: 1 to: 2 input: "points" }
edges { id: 2 from: 2 to: 3 input: "points" }
edges { id: 3 from: 3 to: 9 input: "b" }
edges { id: 4 from: 5 to: 6 input: "time" }
edges { id: 5 from: 6 to: 2 input: "rotation" }
edges { id: 6 from: 5 to: 7 input: "time" }
edges { id: 7 from: 7 to: 2 input: "scale" }
edges { id: 8 from: 8 to: 9 input: "a" }
edges { id: 9 from: 9 to: 4 input: "source" }
