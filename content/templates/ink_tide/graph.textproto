controls {
    titles { key: 1 value: "Music response / 音乐响应" }
    titles { key: 2 value: "Tide flow / 潮汐流速" }
    titles { key: 3 value: "Etching / 等高纹理" }
    snapshots { id: 1 title: "Inlet"
        values { key: 1 value: 0.7 }
        values { key: 2 value: 0.45 }
        values { key: 3 value: 0.25 }
    }
    snapshots { id: 2 title: "Tide"
        values { key: 1 value: 1 }
        values { key: 2 value: 0.8 }
        values { key: 3 value: 0.45 }
    }
    snapshots { id: 3 title: "Surge"
        values { key: 1 value: 1.4 }
        values { key: 2 value: 1.3 }
        values { key: 3 value: 0.8 }
    }
    cues { id: 1 title: "Inlet" seconds: 0 snapshot: 1 fade: 0 smooth: true }
    cues { id: 2 title: "Rising tide" seconds: 3 snapshot: 2 fade: 2 smooth: true }
    cues { id: 3 title: "Surge" seconds: 8 snapshot: 3 fade: 2 smooth: true }
    cues { id: 4 title: "Recede" seconds: 12 snapshot: 1 fade: 3 smooth: true }
}
