schema_version: 2
id: "official-audio-spectrum"
output: 4
canvas { width: 1280 height: 720 }
nodes { id: 1 type_key: "texture.spectrum" schema_version: 1
    properties { key: "spectrum_layout" value { scalar: 1 } }
    properties { key: "bar_count" value { scalar: 96 } }
    properties { key: "color_a" value { color { r: 1 g: 0.15 b: 0.45 a: 1 } } }
    properties { key: "color_b" value { color { r: 0.25 g: 0.1 b: 1 a: 1 } } }
}
nodes { id: 2 type_key: "texture.gradient" schema_version: 1
    properties { key: "color_a" value { color { r: 0.005 g: 0.02 b: 0.06 a: 1 } } }
    properties { key: "color_b" value { color { r: 0.04 g: 0.005 b: 0.08 a: 1 } } }
}
nodes { id: 3 type_key: "texture.blend" schema_version: 1 properties { key: "amount" value { scalar: 1 } } }
nodes { id: 4 type_key: "output.texture" schema_version: 1 }
edges { id: 1 from: 2 to: 3 input: "a" }
edges { id: 2 from: 1 to: 3 input: "b" }
edges { id: 3 from: 3 to: 4 input: "source" }
