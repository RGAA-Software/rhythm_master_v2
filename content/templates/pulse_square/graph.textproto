schema_version: 2
id: "official-pulse-square"
output: 6
canvas { width: 1024 height: 1024 }
nodes { id: 1 type_key: "core.time" schema_version: 1 }
nodes { id: 2 type_key: "time.local" schema_version: 1
    properties { key: "duration" value { scalar: 4 } }
    properties { key: "time_mode" value { scalar: 1 } }
}
nodes { id: 3 type_key: "scalar.curve" schema_version: 1
    properties { key: "curve" value { curve {
        keys { seconds: 0 value: 0 interpolation: INTERPOLATION_SMOOTH }
        keys { seconds: 0.15 value: 1 interpolation: INTERPOLATION_SMOOTH }
        keys { seconds: 1 value: 0.1 interpolation: INTERPOLATION_SMOOTH }
        keys { seconds: 4 value: 0 interpolation: INTERPOLATION_LINEAR }
    } } }
}
nodes { id: 4 type_key: "texture.gradient" schema_version: 1
    properties { key: "color_a" value { color { r: 0.02 g: 0.75 b: 0.5 a: 1 } } }
    properties { key: "color_b" value { color { r: 0.2 g: 0.04 b: 0.55 a: 1 } } }
}
nodes { id: 5 type_key: "texture.transform" schema_version: 1 properties { key: "scale" value { scalar: 0.78 } } }
nodes { id: 6 type_key: "output.texture" schema_version: 1 }
edges { id: 1 from: 1 to: 2 input: "time" }
edges { id: 2 from: 2 to: 3 input: "time" }
edges { id: 3 from: 3 to: 4 input: "amount" }
edges { id: 4 from: 4 to: 5 input: "source" }
edges { id: 5 from: 5 to: 6 input: "source" }
