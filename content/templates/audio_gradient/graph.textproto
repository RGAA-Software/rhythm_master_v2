schema_version: 2
id: "official-audio-gradient"
output: 4
canvas { width: 1280 height: 720 }
nodes { id: 1 type_key: "audio.feature" schema_version: 1
    properties { key: "audio_feature" value { scalar: 1 } }
}
nodes { id: 2 type_key: "scalar.map" schema_version: 1
    properties { key: "input_max" value { scalar: 0.7 } }
}
nodes { id: 3 type_key: "texture.gradient" schema_version: 1
    properties { key: "color_a" value { color { r: 0.01 g: 0.3 b: 0.8 a: 1 } } }
    properties { key: "color_b" value { color { r: 0.8 g: 0.05 b: 0.3 a: 1 } } }
}
nodes { id: 4 type_key: "output.texture" schema_version: 1 }
edges { id: 1 from: 1 to: 2 input: "value" }
edges { id: 2 from: 2 to: 3 input: "amount" }
edges { id: 3 from: 3 to: 4 input: "source" }
