    titles { key: 1 value: "Music response / 音乐响应" }
    titles { key: 2 value: "Mechanical pace / 机械节奏" }
    titles { key: 3 value: "Exposure / 曝光" }
    snapshots { id: 1 title: "Rest"
        values { key: 1 value: 0.6 }
        values { key: 2 value: 0.65 }
        values { key: 3 value: -0.05 }
    }
    snapshots { id: 2 title: "Drive"
        values { key: 1 value: 1.1 }
        values { key: 2 value: 1 }
        values { key: 3 value: 0 }
    }
    snapshots { id: 3 title: "Resonate"
        values { key: 1 value: 1.6 }
        values { key: 2 value: 1.35 }
        values { key: 3 value: 0.08 }
    }
    cues { id: 1 title: "Awaken" seconds: 0 snapshot: 1 fade: 0 smooth: true }
    cues { id: 2 title: "Swing" seconds: 3 snapshot: 2 fade: 2 smooth: true }
    cues { id: 3 title: "Resonate" seconds: 8 snapshot: 3 fade: 2 smooth: true }
    cues { id: 4 title: "Settle" seconds: 12 snapshot: 1 fade: 3 smooth: true }
}
