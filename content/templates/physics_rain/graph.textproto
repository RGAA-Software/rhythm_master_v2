schema_version: 4
id: "official-physics_rain"
canvas { width: 720 height: 1280 }
output: 6
nodes { id: 100 type_key: "component.official.physics_rain" schema_version: 1 }
nodes { id: 5 type_key: "texture.gradient" schema_version: 1
    properties { key: "color_a" value { color { r: 0.01 g: 0.015 b: 0.06 a: 1 } } }
    properties { key: "color_b" value { color { r: 0.05 g: 0.01 b: 0.1 a: 1 } } }
}
nodes { id: 7 type_key: "texture.composite" schema_version: 1 }
nodes { id: 6 type_key: "output.texture" schema_version: 1 }
edges { id: 1 from: 5 to: 7 input: "a" }
edges { id: 2 from: 100 to: 7 input: "b" }
edges { id: 3 from: 7 to: 6 input: "source" }
components {
    type_key: "component.official.physics_rain"
    schema_version: 1
    title: "Bouncing light rain"
    output: 3
    nodes { id: 1 type_key: "point.emitter" schema_version: 1
        properties { key: "particle_capacity" value { scalar: 256 } }
        properties { key: "emission_rate" value { scalar: 45 } }
        properties { key: "lifetime" value { scalar: 10 } }
        properties { key: "center_y" value { scalar: 0.08 } }
        properties { key: "emitter_width" value { scalar: 0.6 } }
        properties { key: "emitter_height" value { scalar: 0 } }
        properties { key: "direction" value { scalar: 90 } }
        properties { key: "particle_speed" value { scalar: 0.03 } }
        properties { key: "gravity_y" value { scalar: 0 } }
        properties { key: "point_size" value { scalar: 0.025 } }
        properties { key: "size_variation" value { scalar: 0.3 } }
        properties { key: "fade_in" value { scalar: 0 } }
        properties { key: "fade_out" value { scalar: 0.05 } }
    }
    nodes { id: 2 type_key: "point.physics2d" schema_version: 1
        properties { key: "body_shape" value { scalar: 0 } }
        properties { key: "restitution" value { scalar: 0.7 } }
        properties { key: "friction" value { scalar: 0.25 } }
    }
    nodes { id: 3 type_key: "point.render" schema_version: 1
        properties { key: "point_blend" value { scalar: 1 } }
    }
    edges { id: 1 from: 1 to: 2 input: "points" }
    edges { id: 2 from: 2 to: 3 input: "points" }
    inputs { key: "emission" node: 1 input: "emission" }
    inputs { key: "burst" node: 1 input: "burst" }
    parameters { key: "emission_rate" node: 1 property: "emission_rate" group: "component.emission" minimum: 0 maximum: 1000 }
    parameters { key: "lifetime" node: 1 property: "lifetime" group: "component.emission" minimum: 0.2 maximum: 20 }
    parameters { key: "restitution" node: 2 property: "restitution" group: "component.motion" }
    parameters { key: "friction" node: 2 property: "friction" group: "component.motion" }
    parameters { key: "seed" node: 1 property: "seed" group: "component.emission" }
    parameters { key: "particle_speed" node: 1 property: "particle_speed" group: "component.motion" minimum: 0 maximum: 2 }
    parameters { key: "direction" node: 1 property: "direction" group: "component.motion" }
    parameters { key: "gravity_y" node: 2 property: "gravity_y" group: "component.motion" minimum: -2 maximum: 2 }
    parameters { key: "point_size" node: 1 property: "point_size" group: "component.palette" minimum: 0 maximum: 0.1 }
    parameters { key: "color_a" node: 1 property: "color_a" group: "component.palette" }
    parameters { key: "color_b" node: 1 property: "color_b" group: "component.palette" }
}
