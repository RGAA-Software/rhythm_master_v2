    titles { key: 1 value: "Music response / 音乐响应" }
    titles { key: 2 value: "Motion pace / 运动速度" }
    titles { key: 3 value: "Exposure / 曝光" }
    titles { key: 4 value: "Bass body / 低频主体" }
    titles { key: 5 value: "Mid flow / 中频流场" }
    titles { key: 6 value: "Treble detail / 高频细节" }
    snapshots { id: 1 title: "Gather"
        values { key: 1 value: 0.6 }
        values { key: 3 value: 0.25 }
        values { key: 4 value: 0.75 }
        values { key: 5 value: 0.75 }
        values { key: 6 value: 0.75 }
    }
    snapshots { id: 2 title: "Develop"
        values { key: 1 value: 1 }
        values { key: 3 value: 0.3 }
        values { key: 4 value: 1 }
        values { key: 5 value: 1 }
        values { key: 6 value: 1 }
    }
    snapshots { id: 3 title: "Crest"
        values { key: 1 value: 1.6 }
        values { key: 3 value: 0.45 }
        values { key: 4 value: 1.45 }
        values { key: 5 value: 1.25 }
        values { key: 6 value: 1.5 }
    }
    cues { id: 1 title: "Gather" seconds: 0 snapshot: 1 fade: 0 smooth: true }
    cues { id: 2 title: "Develop" seconds: 3 snapshot: 2 fade: 2 smooth: true }
    cues { id: 3 title: "Crest" seconds: 8 snapshot: 3 fade: 2 smooth: true }
    cues { id: 4 title: "Resolve" seconds: 12 snapshot: 1 fade: 3 smooth: true }
}
