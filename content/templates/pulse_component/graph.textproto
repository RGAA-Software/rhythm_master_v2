schema_version: 4
id: "official-pulse-component"
output: 200
canvas { width: 1024 height: 1024 }
nodes { id: 100 type_key: "component.official.pulse_card" schema_version: 1 }
nodes { id: 200 type_key: "output.texture" schema_version: 1 }
edges { id: 1 from: 100 to: 200 input: "source" }
components {
    type_key: "component.official.pulse_card"
    schema_version: 1
    title: "Pulse card"
    output: 7
    nodes { id: 1 type_key: "core.time" schema_version: 1 }
    nodes { id: 2 type_key: "time.local" schema_version: 1
        properties { key: "speed" value { scalar: 16 } }
        properties { key: "duration" value { scalar: 360 } }
        properties { key: "time_mode" value { scalar: 1 } }
    }
    nodes { id: 3 type_key: "texture.gradient" schema_version: 1
        properties { key: "color_a" value { color { r: 0.02 g: 0.75 b: 0.5 a: 1 } } }
        properties { key: "color_b" value { color { r: 0.6 g: 0.04 b: 0.7 a: 1 } } }
    }
    nodes { id: 4 type_key: "texture.affine" schema_version: 1
        properties { key: "scale" value { scalar: 0.65 } }
    }
    nodes { id: 5 type_key: "texture.gradient" schema_version: 1
        properties { key: "color_a" value { color { r: 0.01 g: 0.015 b: 0.04 a: 1 } } }
        properties { key: "color_b" value { color { r: 0.05 g: 0.02 b: 0.1 a: 1 } } }
    }
    nodes { id: 7 type_key: "texture.blend" schema_version: 1
        properties { key: "amount" value { scalar: 1 } }
    }
    edges { id: 1 from: 10 to: 2 input: "time" }
    edges { id: 2 from: 2 to: 4 input: "rotation" }
    edges { id: 3 from: 9 to: 4 input: "source" }
    edges { id: 4 from: 5 to: 7 input: "a" }
    edges { id: 5 from: 4 to: 7 input: "b" }
    nodes { id: 8 type_key: "scalar.expression" schema_version: 1
        properties { key: "a" value { scalar: 0.55 } }
        properties { key: "b" value { scalar: 0.25 } }
        properties { key: "c" value { scalar: 0.35 } }
        properties { key: "expression" value { expression: "a + sin(time * tau * b) * c" } }
    }
    nodes { id: 9 type_key: "texture.color_adjust" schema_version: 1 }
    edges { id: 7 from: 10 to: 8 input: "time" }
    
    edges { id: 9 from: 3 to: 9 input: "source" }
    
    signals { name: "pulse" source: 8 }
    bindings { node: 4 input: "scale" signal: "pulse" }
    bindings { node: 3 input: "amount" signal: "pulse" }
    nodes { id: 10 type_key: "time.local" schema_version: 1 }
    edges { id: 10 from: 1 to: 10 input: "time" }
    inputs { key: "time" node: 10 input: "time" }
    parameters { key: "motion_speed" node: 10 property: "speed" group: "component.clock" minimum: 0 maximum: 4 }
    parameters { key: "rotation_speed" node: 2 property: "speed" group: "component.motion" minimum: -16 maximum: 16 }
    parameters { key: "pulse_base" node: 8 property: "a" group: "component.motion" minimum: 0.1 maximum: 1 }
    parameters { key: "pulse_depth" node: 8 property: "c" group: "component.motion" minimum: 0 maximum: 0.4 }
    parameters { key: "pulse_rate" node: 8 property: "b" group: "component.motion" minimum: 0.05 maximum: 4 }
    parameters { key: "color_a" node: 3 property: "color_a" group: "component.palette" }
    parameters { key: "color_b" node: 3 property: "color_b" group: "component.palette" }
    parameters { key: "exposure" node: 9 property: "exposure" group: "component.palette" minimum: -2 maximum: 2 }
}
