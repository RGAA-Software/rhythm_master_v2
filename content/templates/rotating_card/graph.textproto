schema_version: 2
id: "official-rotating_card"
output: 6
canvas { width: 1024 height: 1024 }
nodes { id: 1 type_key: "core.time" schema_version: 1 }
nodes { id: 2 type_key: "time.local" schema_version: 1
    properties { key: "speed" value { scalar: 16 } }
    properties { key: "duration" value { scalar: 360 } }
    properties { key: "time_mode" value { scalar: 1 } }
}
nodes { id: 3 type_key: "texture.gradient" schema_version: 1
    properties { key: "color_a" value { color { r: 0.02 g: 0.75 b: 0.5 a: 1 } } }
    properties { key: "color_b" value { color { r: 0.6 g: 0.04 b: 0.7 a: 1 } } }
}
nodes { id: 4 type_key: "texture.affine" schema_version: 1
    properties { key: "scale" value { scalar: 0.65 } }
}
nodes { id: 5 type_key: "texture.gradient" schema_version: 1
    properties { key: "color_a" value { color { r: 0.01 g: 0.015 b: 0.04 a: 1 } } }
    properties { key: "color_b" value { color { r: 0.05 g: 0.02 b: 0.1 a: 1 } } }
}
nodes { id: 6 type_key: "output.texture" schema_version: 1 }
nodes { id: 7 type_key: "texture.blend" schema_version: 1
    properties { key: "amount" value { scalar: 1 } }
}
edges { id: 1 from: 1 to: 2 input: "time" }
edges { id: 2 from: 2 to: 4 input: "rotation" }
edges { id: 3 from: 3 to: 4 input: "source" }
edges { id: 4 from: 5 to: 7 input: "a" }
edges { id: 5 from: 4 to: 7 input: "b" }
edges { id: 6 from: 7 to: 6 input: "source" }
