diff --git a/CMakeLists.txt b/CMakeLists.txt
index 11e3783..7898192 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -40,6 +40,11 @@ if (POLICY CMP0111)
 endif()
 
 project(msquic)
+if(MSVC AND DEFINED RHYTHM_MSVC_INCLUDE_PREFIX)
+    # CMake 3.28 misdecodes Chinese-only MSVC diagnostics; preserve Ninja dependencies.
+    set(CMAKE_CL_SHOWINCLUDES_PREFIX "${RHYTHM_MSVC_INCLUDE_PREFIX}")
+    add_compile_options(/FC)
+endif()
 
 list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake")
 
@@ -295,9 +300,17 @@ if (WIN32)
     elseif (QUIC_GAMECORE_BUILD)
         message(STATUS "Allowing non-system32 DLLs to be loaded for GameCore")
     else()
-        # Configure linker to only load from the system directory.
-        message(STATUS "Configuring linker to only load from the system directory")
-        set (CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} /DEPENDENTLOADFLAG:0x800")
+        option(RHYTHM_SHARED_TLS_APPLICATION_DIR "Permit bundled external TLS in the application directory" OFF)
+        if(RHYTHM_SHARED_TLS_APPLICATION_DIR)
+            if(NOT QUIC_USE_EXTERNAL_OPENSSL OR NOT QUIC_TLS_LIB STREQUAL "openssl")
+                message(FATAL_ERROR "Application-directory TLS search requires the explicit external OpenSSL profile")
+            endif()
+            # Shared TLS ships beside the executable. Exclude CWD, PATH and user directories.
+            set (CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} /DEPENDENTLOADFLAG:0xA00")
+        else()
+            # Preserve upstream's system-only default for other profiles.
+            set (CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} /DEPENDENTLOADFLAG:0x800")
+        endif()
     endif()
 
     if("${CMAKE_CXX_COMPILER_ID}" STREQUAL "MSVC")
