diff --git a/src/distance.c b/src/distance.c
--- a/src/distance.c
+++ b/src/distance.c
@@ -599,7 +599,6 @@
 	{
 		float radiusA = input->proxyA.radius;
 		float radiusB = input->proxyB.radius;
