                "src/rhythm_render/shaders/godot_environment.sh"
            ],
            "modifications": [
                "Retain the mobile split-sum BRDF approximation, radiance LOD transform, reflection bending and horizon attenuation; sample a bounded linear 2D atlas instead of engine cubemaps.",
                "Lambert diffuse uses a separate cosine-weighted convolution; metallic suppresses diffuse. AO applies only to environment lighting."
            ]
